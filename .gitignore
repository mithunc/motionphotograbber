# Build output — unanchored so it catches every module, not just root
build/
.gradle/
.kotlin/
captures/
.externalNativeBuild
.cxx

# Local machine config
local.properties
*.iml
.DS_Store

# IDE — regenerated by Android Studio, and contributors may not use it at all
.idea/

# Assistant tooling — personal workspace config
.claude/

# Signing material — a leaked upload key is unrecoverable
*.jks
*.keystore
keystore.properties
release/

# Sample motion photos contain real GPS coordinates and capture timestamps.
# Contributors supply their own — see samples/README.md
samples/*.jpg
samples/*.jpeg
samples/*.heic
!samples/README.md
